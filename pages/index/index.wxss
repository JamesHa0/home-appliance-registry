.todo-wrap {
  margin-bottom: 24rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.todo-red { background: var(--danger-light); color: var(--danger); }
.todo-amber { background: var(--warning-light); color: var(--warning); }
.todo-green { background: var(--primary-light); color: var(--primary); }

.todo-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.todo-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-card {
  padding: 28rpx;
}

.device-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-model {
  font-size: 24rpx;
  color: var(--text-hint);
  margin: 10rpx 0 16rpx;
}

.recall-banner {
  background: var(--danger-light);
  color: var(--danger);
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.device-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.warranty {
  font-size: 26rpx;
  font-weight: 500;
}

.w-green { color: var(--primary); }
.w-amber { color: var(--warning); }
.w-red { color: var(--danger); }

.w-date {
  font-size: 24rpx;
  color: var(--text-hint);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-hint);
  margin: 12rpx 0 32rpx;
}

.empty-btn {
  width: 320rpx;
}
