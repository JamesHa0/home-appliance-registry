<view class="container">
  <block wx:if="{{!loading && device}}">
    <!-- 召回警告 -->
    <view wx:if="{{recalled}}" class="recall-banner">
      <view class="recall-title">官方召回提醒</view>
      <view class="recall-text">该型号（{{device.model}}）在市场监管总局缺陷产品召回范围内，请尽快查看召回公告并按指引处理。</view>
      <view class="recall-link">官方公告：samrdprc.org.cn（搜索品牌+型号）</view>
    </view>

    <!-- 设备信息 -->
    <view class="card">
      <view class="device-head">
        <text class="device-name">{{device.name}}</text>
        <text class="tag {{device.category ? 'tag-green' : ''}}">{{device.category}}</text>
        <text wx:if="{{device.archived}}" class="tag tag-gray">已归档</text>
      </view>
      <view class="device-meta">
        <text>{{device.brand}} · {{device.model}}</text>
      </view>
      <view class="device-meta">购机日 {{device.purchaseDate}}</view>
    </view>

    <!-- 保修状态 -->
    <view class="card">
      <view class="card-title">保修状态</view>
      <view class="ws-big {{ws.status === 'expired' ? 'c-red' : (ws.status === 'expiring' ? 'c-amber' : 'c-green')}}">
        {{ws.text}}
      </view>
      <view class="ws-line">保修到期：{{device.warrantyEnd || '未设置'}}（保修 {{device.warrantyYears}} 年）</view>
    </view>

    <!-- 服务入口 -->
    <view class="card">
      <view class="card-title">服务入口</view>
      <view wx:if="{{afterSale && afterSale.phone}}" class="service-row">
        <text class="service-label">官方客服</text>
        <text class="service-phone" bindtap="callPhone" data-phone="{{afterSale.phone}}">{{afterSale.phone}}</text>
      </view>
      <view wx:else class="service-row">
        <text class="service-label">官方客服</text>
        <text class="service-phone">拨打 114 查询 {{device.brand}} 售后</text>
      </view>
      <view class="service-row" hover-class="service-row-hover" bindtap="openManual">
        <text class="service-label">说明书</text>
        <text class="service-action">复制官网说明书入口 →</text>
      </view>
    </view>

    <view class="action-buttons">
      <block wx:if="{{!device.archived}}">
        <button class="btn-primary edit-btn" bindtap="goEditDevice">
          <text>编辑信息</text>
        </button>
        <button class="btn-ghost delete-btn" bindtap="archiveDevice">
          <text>归档该设备</text>
        </button>
      </block>
      <block wx:else>
        <button class="btn-primary edit-btn" bindtap="restoreDevice">
          <text>恢复设备</text>
        </button>
        <button class="btn-danger delete-btn" bindtap="deleteDevice">
          <text>永久删除</text>
        </button>
      </block>
    </view>
  </block>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
</view>

<privacy-popup />
