.recall-banner {
  background: var(--danger-light);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.recall-title {
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.recall-text {
  color: #791F1F;
  font-size: 26rpx;
  line-height: 1.6;
}

.recall-link {
  color: var(--danger);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.device-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.device-name {
  font-size: 34rpx;
  font-weight: 500;
  flex: 1;
  margin-right: 16rpx;
}

.device-meta {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-top: 10rpx;
}

.ws-big {
  font-size: 40rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.c-green { color: var(--primary); }
.c-amber { color: var(--warning); }
.c-red { color: var(--danger); }

.ws-line {
  font-size: 26rpx;
  color: var(--text-sub);
}

.service-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.service-row:last-child {
  border-bottom: none;
}

.service-label {
  font-size: 28rpx;
  color: var(--text-sub);
}

.service-phone {
  font-size: 28rpx;
  color: var(--info);
}

.service-action {
  font-size: 28rpx;
  color: var(--primary);
}

.delete-btn {
  flex: 1;
  color: var(--danger);
  background: var(--danger-light);
}

/* Action buttons container */
.action-buttons {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
}

.edit-btn {
  flex: 1;
  background-color: var(--primary);
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  transition: all 0.3s ease;
}

.edit-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-danger {
  flex: 1;
  background-color: #A32D2D;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
}

.service-row-hover {
  background: var(--primary-light);
}
