.explain-text {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.config-warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--warning);
  background: var(--warning-light);
  border-radius: 12rpx;
  padding: 16rpx;
  line-height: 1.6;
}

.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-info {
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
}

.sub-name {
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-meta {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

.sub-btn {
  font-size: 26rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sub-btn.done {
  opacity: 0.7;
}

.footnote {
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.6;
}
