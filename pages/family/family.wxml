<view class="container">
  <!-- 已有家庭 -->
  <block wx:if="{{family}}">
    <view class="card">
      <view class="card-title">{{family.name}}</view>
      <view class="invite-row">
        <text class="invite-label">家庭邀请码</text>
        <text class="invite-code">{{family.inviteCode}}</text>
        <text class="invite-copy" bindtap="copyInvite">复制</text>
      </view>
      <view class="invite-hint">家人打开小程序 → 家庭 → 输入邀请码即可加入，共用同一份设备清单</view>
    </view>

    <!-- 首次引导：设置昵称头像 -->
    <view wx:if="{{!myNickname}}" class="profile-guide" bindtap="openProfileEdit">
      <text>设置昵称头像，让家人一眼认出你</text>
      <text class="guide-arrow">›</text>
    </view>

    <view class="card">
      <view class="card-title">家庭成员（{{members.length}}）</view>
      <view wx:for="{{members}}" wx:key="key" class="member-row">
        <image wx:if="{{item.avatarFileId}}" class="member-avatar" src="{{item.avatarFileId}}" mode="aspectFill" />
        <view wx:else class="member-avatar member-avatar-empty">{{item.avatarChar}}</view>
        <view class="member-info">
          <view class="member-name-line">
            <text class="member-label">{{item.label}}</text>
            <text wx:if="{{item.isOwner}}" class="member-role">创建者</text>
          </view>
        </view>
        <text wx:if="{{item.isMe}}" class="member-edit" catchtap="openProfileEdit">编辑</text>
      </view>
    </view>

    <button class="btn-primary" open-type="share">邀请家人加入</button>
    
    <!-- 非创建者：退出家庭（解除成员死锁） -->
    <view wx:if="{{!isOwner}}" class="leave-family-row">
      <text class="leave-hint">不是创建者？点击退出家庭</text>
      <button class="btn-danger leave-btn" bindtap="leaveFamily">退出家庭</button>
    </view>

    <!-- 创建者：解散家庭入口做小为文本链接，降低误触（owner 的唯一出口） -->
    <view wx:if="{{isOwner}}" class="dissolve-row">
      <text class="dissolve-link" bindtap="dissolveFamily">家庭不再使用？</text>
    </view>
  </block>

  <!-- 无家庭 -->
  <block wx:else>
    <view class="card empty">
      <view>还没有家庭</view>
      <view class="empty-sub">创建家庭后，全家人的家电档案和保修提醒集中一处</view>
      <button class="btn-primary empty-btn" bindtap="createFamily" loading="{{creating}}" disabled="{{creating}}">
        创建我的家庭
      </button>
    </view>

    <view class="card">
      <view class="card-title">加入已有家庭</view>
      <input
        class="join-input"
        placeholder="输入 6 位家庭邀请码"
        value="{{inviteCodeInput}}"
        bindinput="onInviteInput"
        maxlength="6"
      />
      <button class="btn-ghost join-btn" bindtap="joinFamily" loading="{{joining}}" disabled="{{joining}}">
        加入家庭
      </button>
    </view>
  </block>

  <!-- 昵称头像编辑弹窗 -->
  <view wx:if="{{showProfileEdit}}" class="mask" bindtap="closeProfileEdit">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">编辑昵称头像</view>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{editAvatarUrl}}" class="avatar-preview" src="{{editAvatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-preview avatar-preview-empty">选择头像</view>
      </button>
      <input
        class="nickname-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{editNickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
      <view class="sheet-actions">
        <button class="btn-ghost sheet-btn" bindtap="closeProfileEdit">取消</button>
        <button class="btn-primary sheet-btn" bindtap="saveProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}">保存</button>
      </view>
    </view>
  </view>
</view>

<privacy-popup />
