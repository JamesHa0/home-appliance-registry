.invite-row {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.invite-label {
  font-size: 28rpx;
  color: var(--text-sub);
}

.invite-code {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--primary);
  letter-spacing: 6rpx;
  margin: 0 20rpx;
  font-family: monospace;
}

.invite-copy {
  font-size: 26rpx;
  color: var(--info);
}

.invite-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 16rpx;
  line-height: 1.6;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.member-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 16rpx;
}

.member-label {
  font-size: 28rpx;
  flex: 1;
}

.member-short {
  font-size: 24rpx;
  color: var(--text-hint);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-hint);
  margin: 12rpx 0 32rpx;
}

.empty-btn {
  width: 320rpx;
}

.join-input {
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.join-btn {
  margin-top: 24rpx;
  width: 100%;
}
