<view class="container">
  <!-- 扫码识别 -->
  <view class="card scan-card">
    <view class="edit-banner" wx:if="{{isEditMode}}">
      <icon type="info" size="16" color="#07c160"/>
      <text>正在编辑设备信息</text>
    </view>
    
    <button class="btn-primary scan-btn" bindtap="scan" loading="{{recognizing}}" disabled="{{recognizing || isEditMode}}">
      扫机身码 / 条码识别
    </button>
    <view class="scan-hint">扫家电外包装条码或机身铭牌码，自动识别品牌型号</view>
    <view wx:if="{{scanned && scanned.found}}" class="scan-result">
      已识别：{{scanned.brand}} · {{scanned.name || scanned.model || '型号未知'}}
    </view>
    <view wx:if="{{scanned && !scanned.found}}" class="scan-result scan-miss">
      条码 {{scanned.raw}} 未在型号库命中，请手动补全下方信息
    </view>
  </view>

  <!-- 建档表单 -->
  <view class="card">
    <view class="card-title">设备信息</view>

    <view class="form-item">
      <text class="form-label">品牌</text>
      <input class="form-input" placeholder="如：美的 / 海尔 / 小米" value="{{form.brand}}" data-field="brand" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">品类</text>
      <picker range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
        <view class="form-input {{categoryIndex < 0 ? 'placeholder' : ''}}">
          {{categoryIndex >= 0 ? categories[categoryIndex] : '请选择品类'}}
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">型号</text>
      <input class="form-input" placeholder="机身铭牌上的型号，如 KFR-35GW" value="{{form.model}}" data-field="model" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">名称</text>
      <input class="form-input" placeholder="可选，如 客厅空调" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">购机日期</text>
      <picker mode="date" value="{{form.purchaseDate}}" end="{{form.purchaseDate}}" bindchange="onDate">
        <view class="form-input">{{form.purchaseDate}}</view>
      </picker>
    </view>

    <view wx:if="{{warrantyEnd}}" class="warranty-preview">
      按 {{form.brand || '该品牌'}} 保修政策：保修 {{warrantyYears}} 年，到期日 {{warrantyEnd}}
    </view>

    <view class="ugc-row">
      <view class="ugc-text">
        <view class="ugc-title">贡献型号到型号库</view>
        <view class="ugc-sub">该型号不在库中时，建档同时帮到同型号用户</view>
      </view>
      <switch checked="{{contribute}}" color="#0F6E56" bindchange="onContributeChange" />
    </view>

    <button class="btn-primary save-btn" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存建档</button>
  </view>
</view>
