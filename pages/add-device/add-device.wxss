.scan-btn {
  width: 100%;
}

.scan-btn[disabled] {
  opacity: 0.6;
}

.edit-banner {
  background-color: #e8f5e9;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #07c160;
  font-weight: 500;
}

.scan-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  margin-top: 16rpx;
}

.scan-result {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--primary);
  text-align: center;
  background: var(--primary-light);
  border-radius: 12rpx;
  padding: 16rpx;
}

.scan-miss {
  color: var(--warning);
  background: var(--warning-light);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  min-height: 44rpx;
}

.placeholder {
  color: var(--text-hint);
}

.warranty-preview {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--info);
  background: var(--info-light);
  border-radius: 12rpx;
  padding: 16rpx;
}

.save-btn {
  margin-top: 32rpx;
  width: 100%;
}

/* ---------- 型号搜索自动补全（官方备案联想） ---------- */

.model-wrap {
  position: relative;
}

/* 候选浮层：绝对定位遮住下方表单，不推挤布局；高度最多 4 条，控制在键盘可视区内 */
.model-dropdown {
  position: absolute;
  left: 160rpx;
  right: 0;
  top: calc(100% + 4rpx);
  z-index: 20;
  background: #ffffff;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  border-radius: 12rpx;
  overflow: hidden;
}

.model-candidate {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.model-candidate:last-child {
  border-bottom: none;
}

.model-candidate-hover {
  background: var(--info-light, #e8f1fb);
}

.mc-main {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.4;
}

.mc-sub {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

/* 搜索不到时的一行灰字提示（同样绝对定位，不推挤布局） */
.model-search-hint {
  position: absolute;
  left: 160rpx;
  right: 0;
  top: calc(100% + 4rpx);
  z-index: 20;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  background: #fafafa;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 12rpx;
}
