.scan-btn {
  width: 100%;
}

.scan-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  text-align: center;
  margin-top: 16rpx;
}

.scan-result {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--primary);
  text-align: center;
  background: var(--primary-light);
  border-radius: 12rpx;
  padding: 16rpx;
}

.scan-miss {
  color: var(--warning);
  background: var(--warning-light);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  min-height: 44rpx;
}

.placeholder {
  color: var(--text-hint);
}

.warranty-preview {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--info);
  background: var(--info-light);
  border-radius: 12rpx;
  padding: 16rpx;
}

.ugc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: var(--primary-light);
  border-radius: 12rpx;
}

.ugc-text {
  flex: 1;
  margin-right: 20rpx;
}

.ugc-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.ugc-sub {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.save-btn {
  margin-top: 32rpx;
  width: 100%;
}
