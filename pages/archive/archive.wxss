.container {
  padding: 24rpx 24rpx 64rpx;
  background: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  color: #888780;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.archive-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.archive-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.archive-info {
  flex: 1;
}

.archive-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.archive-meta {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
}

.archive-time {
  font-size: 22rpx;
  color: #b4b2a9;
  margin-top: 8rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.tag-gray {
  background: #f1efe8;
  color: #888780;
}

.archive-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.archive-btn {
  flex: 1;
  font-size: 28rpx;
  margin: 0;
}

.btn-danger {
  background: #a32d2d;
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
}

.btn-danger::after {
  border: none;
}
