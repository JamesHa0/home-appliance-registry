.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-card {
  width: 580rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: #0F6E56;
}

.privacy-btns {
  display: flex;
  gap: 24rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin: 0;
  padding: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn-ghost {
  background: #f5f6f8;
  color: #666666;
}

.privacy-btn-primary {
  background: #0F6E56;
  color: #ffffff;
}
